; =====================================================================
;  blink_led.mic — тестовый скетч: моргание светодиодом на PB0
;  МК КР1878ВЕ1 (ядро ТЕСЕЙ), ассемблер TESSA-совместимый
;
;  Схема: светодиод между PB0 и GND (через резистор ~330 Ом),
;         плюс к VCC. PB0 настраивается как активный выход.
;
;  Карта периферии (память данных):
;    00h  RS — регистр состояния процессора
;    02h  порт B, рабочий регистр (PB0..PB7)
;    1Ah  порт B, регистр конфигурации (подрегистры 0..7)
;         подрегистр 0 (PT)  — тип вывода: 1 = вход/выход
;         подрегистр 1 (OT)  — тип выхода: 1 = активный
;         подрегистр 2 (RE)  — нагрузочный резистор 10k
;  Сегменты адресации (базы SR0..SR3):
;    SR0 = 00h  -> %a0..%a7 = адреса 00h..07h
;    SR1 = 18h  -> %b0..%b7 = адреса 18h..1Fh
; =====================================================================

; ---- векторы прерываний (первые 16 слов) ----
        jmp     start           ; 000h  начальный запуск
        .word   0FFFFh, 0FFFFh, 0FFFFh, 0FFFFh   ; 001h..004h
        .word   0FFFFh, 0FFFFh, 0FFFFh, 0FFFFh   ; 005h..008h
        .word   0FFFFh, 0FFFFh, 0FFFFh, 0FFFFh   ; 009h..00Ch
        .word   0FFFFh, 0FFFFh, 0FFFFh           ; 00Dh..00Fh

; ---- программа ----
start:
        ldr     #a,0            ; SR0 (сегмент A) = 00h -> периферия/ОЗУ
        ldr     #b,18h          ; SR1 (сегмент B) = 18h -> конфиг. порта B

        ; --- настройка PB0 как активного выхода ---
        ; подрегистр 0 (тип вывода PT): выбрать подрег.0 + бит WR
        movl    %b2,08h         ; конфиг: SR=0, WR=1 (подрегистр 0)
        movl    %b2,01h         ; PT0=1 -> PB0 вход/выход
        ; подрегистр 1 (тип выхода OT): выбрать подрег.1 + бит WR
        movl    %b2,09h         ; конфиг: SR=1, WR=1
        movl    %b2,01h         ; OT0=1 -> активный выход
        ; подрегистр 2 (нагрузочный резистор RE): выбрать подрег.2 + бит WR
        movl    %b2,0Ah         ; конфиг: SR=2, WR=1
        movl    %b2,00h         ; RE0=0 -> без подтяжки

main_loop:
        ; --- зажечь PB0 (бит 0 рабочего регистра порта B) ---
        movl    %a2,01h         ; порт B (02h) = 01h -> PB0 = 1
        ; пауза ~0.25 с (эмпирически: 2 такта на команду, вложенный счётчик)
        ldr     #d,0E0h         ; SR3 (сегмент D) = 0E0h -> ОЗУ/данные
        movl    %d0,0FFh        ; внешний счётчик задержки
outer:
        movl    %d1,0FFh        ; внутренний счётчик
inner:
        dec     %d1
        jnz     inner
        dec     %d0
        jnz     outer

        ; --- погасить PB0 ---
        movl    %a2,00h         ; порт B (02h) = 00h -> PB0 = 0
        ldr     #d,0E0h
        movl    %d0,0FFh
outer2:
        movl    %d1,0FFh
inner2:
        dec     %d1
        jnz     inner2
        dec     %d0
        jnz     outer2

        jmp     main_loop
